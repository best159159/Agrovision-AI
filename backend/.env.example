LOCAL_MODEL_PATH=models/plant-disease.pt
CONFIDENCE_THRESHOLD=0.25
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Production default is false. Set true only for demos without a trained model.
ENABLE_DEMO_MODE=false

# Research feedback privacy. Images are not retained unless explicitly enabled.
STORE_FEEDBACK_IMAGES=false
# Required to read feedback records or export the training dataset.
AGROVISION_ADMIN_TOKEN=

# Practical guardrails for field uploads.
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=150
MAX_VIDEO_FRAMES=120

# Optional: the single external disease-screening provider.
# crop_health is best for food crops and field scouting.
# plant_health is broader for houseplants, ornamentals, and general plant health.
PREFERRED_CLOUD_AI=kindwise_crop
KINDWISE_API_KEY=
KINDWISE_PRODUCT=crop_health
KINDWISE_LANGUAGE=en
KINDWISE_MIN_PROBABILITY=0.03
KINDWISE_TIMEOUT_SECONDS=30

# Optional: grounded explanation of completed scan evidence.
# OpenAI does not create the diagnosis and uploaded images are not sent to it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=30

# Optional: environment enrichment for hybrid analysis.
# Uses Open-Meteo by default for weather forecast and soil moisture layers.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
